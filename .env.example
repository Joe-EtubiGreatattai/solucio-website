# Website (Vercel and local): send /api to the backend on the Solucio server
BOOKING_API_ORIGIN=https://solucio-website.techtree.lifestyle

# ---- The rest is for the backend itself (on the server: /var/www/solucio-website-api/.env) ----
# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.

# Where bookings are stored (MongoDB Atlas in production). The database name is part of the URI.
MONGODB_URI=mongodb://127.0.0.1:27017/solucio_website

# Front desk at /desk: one shared password, and a random secret of 32+ characters for the sign-in cookie
DESK_PASSWORD=
DESK_SECRET=

# Email (optional). Without SMTP_HOST, bookings still work; emails are just not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Solucio Clinic <appointments@example.com>"
# Where new-request alerts go
CLINIC_EMAIL=
# Used in email links, e.g. https://solucio-website.vercel.app
SITE_URL=
# Site addresses allowed to make front-desk changes through the proxy (comma separated)
ALLOWED_ORIGINS=https://solucio-website.vercel.app
